# Environment & Session Security
NODE_ENV=development
# SESSION_SECRET is strictly required in production (min 16 chars). Leave blank in example.
SESSION_SECRET=

# Primary Transactional Database (Layerbase SQLite / LibSQL)
# Development uses local file:local.db. Production requires Layerbase URL & auth token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Cloudflare Worker R2 Media Storage Binding (Recommended for Workers)
# When running on Cloudflare Workers, the MEDIA_BUCKET binding is automatically available.
# No S3 keys/secrets are needed for Worker execution.

# Optional Non-Worker S3-Compatible R2 Credentials (Only needed for standalone Node servers)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=verane-media-dev
R2_PUBLIC_URL=

# Public Client Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
